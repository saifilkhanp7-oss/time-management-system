PORT=4000
# Change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# --- SMS OTP via Twilio (optional; without these, OTPs print in the server console) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Twilio phone number (E.164) ...
TWILIO_FROM=
# ... or a Messaging Service SID
TWILIO_MESSAGING_SERVICE_SID=

# --- AI analyst via Claude (optional; without it, built-in rule-based insights are used) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Comma-separated allowed origins for CORS (leave empty during local dev)
CLIENT_ORIGIN=
